# Copy this file to lab.env and fill it with your Canvas AWS Lab values.
# lab.env is ignored by git and should never be committed.

# Canvas temporary AWS credentials.
# Copy these from Canvas at the start of every lab session.
AWS_REGION="us-east-1"
AWS_DEFAULT_REGION="us-east-1"
AWS_ACCESS_KEY_ID="PASTE_CANVAS_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="PASTE_CANVAS_SECRET_KEY"
AWS_SESSION_TOKEN="PASTE_CANVAS_SESSION_TOKEN"
USE_IAM_ROLE="false"

# Terraform input values collected from AWS Console.
LAB_REGION="us-east-1"
LAB_VPC_ID="vpc-xxxxxxxxxxxxxxxxx"
LAB_PUBLIC_SUBNET_IDS='["subnet-aaaaaaaaaaaaaaaaa","subnet-bbbbbbbbbbbbbbbbb"]'
LAB_AMI_ID="ami-xxxxxxxxxxxxxxxxx"
LAB_KEY_NAME="cloud-devops-lab-key"
LAB_PRIVATE_KEY_FILE="/absolute/path/to/cloud-devops-lab-key.pem"
LAB_SSH_CIDR="YOUR_PUBLIC_IP/32"

# Terraform outputs.
# Fill these after `terraform output`.
AUTO_SCALING_GROUP_NAME="PASTE_TERRAFORM_auto_scaling_group_name"
LOAD_BALANCER_ARN="PASTE_TERRAFORM_load_balancer_arn"
TARGET_GROUP_ARN="PASTE_TERRAFORM_target_group_arn"
ALB_DNS_NAME="PASTE_TERRAFORM_alb_dns_name"

# Derived load-test target.
# Leave blank to derive from ALB_DNS_NAME, or set explicitly.
LOAD_TEST_TARGET_BASE=""

# Local dashboard settings.
FLASK_ENV="production"
APP_HOST="127.0.0.1"
APP_PORT="5000"
DASHBOARD_RUNTIME_POLICY="local_only"
ALLOW_DASHBOARD_ON_AWS="false"
LOCAL_DEMO_WORK_ENABLED="false"
MONITORING_LABEL="AWS Auto-Scaling Monitoring & Control Dashboard"

# Custom dashboard controller. Terraform creates the ASG; this app submits scaling decisions.
SCALING_MODE="custom"
SCALE_OUT_CPU_THRESHOLD="70"
SCALE_IN_CPU_THRESHOLD="30"
SCALER_SCALE_OUT_CONFIRMATION_SAMPLES="1"
SCALER_SCALE_IN_CONFIRMATION_SAMPLES="2"
SCALER_REQUEST_SIGNAL_THRESHOLD="3"
SCALER_SCALE_OUT_REQUEST_SIGNAL_THRESHOLD="1"
SCALER_FAST_SCALE_OUT_STEP="2"
SCALER_FAST_SCALE_OUT_CPU_RATIO="1.05"
SCALER_FAST_SCALE_IN_STEP="2"
SCALER_FAST_SCALE_IN_CPU_RATIO="0.5"
SCALER_IDLE_COLLAPSE_CPU_RATIO="0.8"
SCALER_MIN_INSTANCES="1"
SCALER_MAX_INSTANCES="4"
SCALER_HARD_MIN_INSTANCES="1"
SCALER_HARD_MAX_INSTANCES="10"
SCALER_COOLDOWN_SECONDS="60"
CONTROL_ENABLED="true"
CONTROL_API_TOKEN="replace-with-a-random-token"
CONTROL_ALLOW_FORCE="false"

# Logging and local data paths.
LOG_TO_S3="false"
S3_LOG_BUCKET=""
METRICS_CSV_PATH="data/metrics.csv"
EVENTS_CSV_PATH="data/events.csv"
SQLITE_PATH="data/metrics.db"
CONTROLLER_STATE_PATH="data/controller_state.json"
DEMO_WORK_MAX_ITERATIONS="8000000"
AWS_METRIC_WINDOW_MINUTES="60"
AWS_METRIC_PERIOD_SECONDS="60"
POLL_INTERVAL_SECONDS="10"
EC2_TAG_KEY=""
EC2_TAG_VALUE=""

# Ansible defaults.
ANSIBLE_USER="ec2-user"
