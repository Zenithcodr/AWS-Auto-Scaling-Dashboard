FLASK_ENV=production
APP_HOST=127.0.0.1
APP_PORT=5000

# The monitoring dashboard is a local Mac app. Terraform/Ansible manage AWS resources,
# but this dashboard should not be deployed onto those AWS instances.
DASHBOARD_RUNTIME_POLICY=local_only
ALLOW_DASHBOARD_ON_AWS=false
LOCAL_DEMO_WORK_ENABLED=false

# Lab / temporary credential setup:
# 1. Keep USE_IAM_ROLE=false
# 2. Paste your temporary AWS credentials below
# 3. Keep AWS_SESSION_TOKEN filled when your lab gives session-based credentials
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=PASTE_YOUR_TEMP_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=PASTE_YOUR_TEMP_SECRET_ACCESS_KEY
AWS_SESSION_TOKEN=PASTE_YOUR_TEMP_SESSION_TOKEN
USE_IAM_ROLE=false

MONITORING_LABEL=AWS Auto-Scaling Monitoring & Control Dashboard
EC2_TAG_KEY=
EC2_TAG_VALUE=
AUTO_SCALING_GROUP_NAME=PASTE_TERRAFORM_ASG_NAME_HERE
LOAD_BALANCER_ARN=PASTE_TERRAFORM_ALB_ARN_HERE
TARGET_GROUP_ARN=PASTE_TERRAFORM_TARGET_GROUP_ARN_HERE
AWS_METRIC_WINDOW_MINUTES=60
# Terraform enables detailed EC2 monitoring so the custom controller can use 1-minute CPU signals.
AWS_METRIC_PERIOD_SECONDS=60
POLL_INTERVAL_SECONDS=10

# Custom dashboard controller. Terraform creates the ASG; this app submits scaling decisions.
SCALING_MODE=custom
SCALE_OUT_CPU_THRESHOLD=70
SCALE_IN_CPU_THRESHOLD=30
SCALER_SCALE_OUT_CONFIRMATION_SAMPLES=1
SCALER_SCALE_IN_CONFIRMATION_SAMPLES=2
SCALER_REQUEST_SIGNAL_THRESHOLD=3
SCALER_SCALE_OUT_REQUEST_SIGNAL_THRESHOLD=1
SCALER_FAST_SCALE_OUT_STEP=2
SCALER_FAST_SCALE_OUT_CPU_RATIO=1.05
SCALER_FAST_SCALE_IN_STEP=2
SCALER_FAST_SCALE_IN_CPU_RATIO=0.5
SCALER_IDLE_COLLAPSE_CPU_RATIO=0.8
SCALER_MIN_INSTANCES=1
SCALER_MAX_INSTANCES=4
SCALER_HARD_MIN_INSTANCES=1
SCALER_HARD_MAX_INSTANCES=10
SCALER_COOLDOWN_SECONDS=60

CONTROL_ENABLED=true
CONTROL_API_TOKEN=replace-with-a-random-token
CONTROL_ALLOW_FORCE=false

LOG_TO_S3=false
S3_LOG_BUCKET=
METRICS_CSV_PATH=data/metrics.csv
EVENTS_CSV_PATH=data/events.csv
SQLITE_PATH=data/metrics.db
CONTROLLER_STATE_PATH=data/controller_state.json

DEMO_WORK_MAX_ITERATIONS=8000000
